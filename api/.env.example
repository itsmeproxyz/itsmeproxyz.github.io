# Template for api/.env (local testing only).
# Copy this file to .env, then fill in your own values there.
# Never commit .env, and never put real passwords in this file.
# If a value contains a # sign, wrap that value in double quotes.

# --- Local SQL Server Express (see database/create-login.sql) ---
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=proxyz
DB_USER=proxyz_app
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_CERT=true

# --- Azure SQL: use these lines in place of the local block above ---
# DB_SERVER=your-server.database.windows.net
# DB_PORT=1433
# DB_NAME=your-database
# DB_USER=proxyz_app
# DB_PASSWORD=
# DB_ENCRYPT=true
# DB_TRUST_CERT=false

# --- API ---
# Long random admin key, 32 characters or more
ADMIN_KEY=
# Websites allowed to call the API, comma separated, no slash at the end
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
PORT=3000
